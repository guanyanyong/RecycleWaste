# ===== 应用 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== 数据库（腾讯云 MySQL）=====
DB_HOST=sh-cdb-om3hqg2y.sql.tencentcdb.com
DB_PORT=23159
DB_USER=root
DB_PASSWORD=请填写真实密码
DB_NAME=RecycleWaste
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ===== 认证 =====
# 生产环境请改为 32 位以上随机串：openssl rand -hex 32
JWT_SECRET=please-change-this-secret-in-production
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# ===== CORS（显式来源，逗号分隔）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
